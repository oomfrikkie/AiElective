# Copy to .env and fill in. .env is gitignored, never commit it.

# ── Gemini (AI service) ──
GEMINI_API_KEY=your-gemini-api-key
# Model for the teacher tips after a lesson (optional)
GEMINI_MODEL=gemini-3.5-flash-lite
# Text models, fastest first; a slow or overloaded one is skipped for the next (optional)
# GEMINI_MODELS=gemini-3.1-flash-lite-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Text-to-speech models (optional)
# GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview

# ── NestJS API ──
# Any long random string. Docker uses a dev default if empty; set your own for anything public.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── PostgreSQL ──
# Docker creates the database with these. Running the API outside Docker? Use DB_HOST=localhost.
DB_USER=hettie
DB_PASSWORD=hettie
DB_NAME=hettie

# ── Running without Docker only ──
# AI_SERVICE_URL=http://localhost:8000
# VITE_API_URL / VITE_USER_API_URL go in frontend/.env (default: localhost:8000 / localhost:3000)
